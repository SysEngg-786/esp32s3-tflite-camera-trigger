# File: .gitignore
# Path: esp32s3-tflite-camera-trigger/.gitignore

# ESP-IDF build output — fully regenerated by idf.py build
# Never committed; binary size alone makes this impractical
build/

# Managed components — downloaded at build time by idf_component_manager
# from idf_component.yml + dependencies.lock; not source, not committed
managed_components/

# Generated sdkconfig — derived from sdkconfig.defaults by idf.py set-target
# sdkconfig.defaults is the committed source of truth; sdkconfig is the
# machine-specific expansion of it and is regenerated on each clean setup
sdkconfig

# Editor and OS artifacts
.vscode/
.idea/
*.DS_Store
Thumbs.db