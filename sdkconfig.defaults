# File: sdkconfig.defaults
# Path: esp32s3-tflite-camera-trigger/sdkconfig.defaults
# Role: Hardware baseline for the Seeed Xiao ESP32-S3 Sense.
#       These defaults are applied before menuconfig — they lock the settings
#       that must be correct for the board to initialise at all.
#       Any setting not listed here stays at the ESP-IDF upstream default.
#
# MVP note: production hardening (watchdog tuning, power management,
#   secure boot, NVS encryption) is not configured here — this is an
#   MVP demonstrator, not an operational product. Named gaps, not omissions.

# ── Flash ──────────────────────────────────────────────────────────────────
# Xiao S3 Sense carries 8 MB flash (W25Q64).
# Must match physical hardware or the partition table silently truncates.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# ── PSRAM ──────────────────────────────────────────────────────────────────
# Xiao S3 Sense carries 8 MB OPI PSRAM (PSRAM8).
# OPI (octal SPI) mode at 80 MHz is required for this specific chip variant.
# PSRAM backs three critical allocations:
#   1. Camera DMA frame buffers (two buffers, ~460 KB each at VGA)
#   2. TFLite Micro inference arena (~2–3 MB for MobileNetV2 INT8)
#   3. SPIFFS read buffer for model load at boot
# Without PSRAM enabled the system halts at camera or TFLite arena init.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y

# Route large heap allocations to PSRAM automatically.
# Internal SRAM is reserved for ISR stacks and time-critical DMA paths.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Fail hard at boot if PSRAM is not detected — do not silently continue
# with internal SRAM only (would cause arena allocation failure later).
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# ── Partition table ────────────────────────────────────────────────────────
# Custom table defined in partitions.csv.
# Decision: SPIFFS partition carries the MobileNetV2 INT8 model (~3.4 MB)
#   loaded into PSRAM arena once at boot. See partitions.csv for layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Task stack ─────────────────────────────────────────────────────────────
# Main task stack enlarged to accommodate TFLite Micro interpreter setup
# and the SPIFFS model load call at boot.
# MVP note: a dedicated inference task with a tuned stack is a post-MVP
#   refinement — main task stack enlarged here as the simplest correct path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── WiFi ───────────────────────────────────────────────────────────────────
# Modest RX buffer increase to keep the HTTP POST reliable under the
# inference loop's memory pressure. Not a production WiFi tune.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# ── Camera clock ───────────────────────────────────────────────────────────
# XCLK conservative default for first bring-up.
# The OV2640 is stable at 20 MHz; 10 MHz is available if signal integrity
# issues appear on a specific board (rework in camera_init.cpp, not here).
CONFIG_CAMERA_XCLK_FREQ_HZ=20000000
